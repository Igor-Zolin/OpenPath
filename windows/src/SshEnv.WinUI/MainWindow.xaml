<Window
    x:Class="SshEnv.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SshEnv.WinUI"
    Title="OpenPath">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="RowStyle" TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="16" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="14,7" />
            </Style>
            <Style x:Key="RowLabelStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="DividerStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="Margin" Value="14,0" />
            </Style>
        </Grid.Resources>

        <NavigationView
            x:Name="Navigation"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            PaneDisplayMode="Top">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNav" Content="Home" Icon="Home" IsSelected="True" Tag="Home" />
                <NavigationViewItem x:Name="LogsNav" Content="Logs" Icon="Document" Tag="Logs" />
                <NavigationViewItem x:Name="TunnelingNav" Content="Tunneling" Icon="Link" Tag="Tunneling" />
                <NavigationViewItem x:Name="SettingsNav" Content="Settings" Icon="Setting" Tag="Settings" />
            </NavigationView.MenuItems>

            <Grid MaxWidth="768" Margin="20,12,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar x:Name="Notice" IsClosable="True" />

                <Grid x:Name="HomePage" Grid.Row="1" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="12">
                        <TextBlock x:Name="HomeTitle" Style="{StaticResource TitleTextBlockStyle}" Text="Connection" />

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource RowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Name="ConnectionLabel" FontWeight="SemiBold" Text="Connection status" />
                                        <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryTextStyle}" Text="Disconnected" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="ConnectionSwitch"
                                        Grid.Column="1"
                                        MinWidth="0"
                                        AutomationProperties.LabeledBy="{Binding ElementName=ConnectionLabel}"
                                        OffContent=""
                                        OnContent="" />
                                </Grid>
                                <Border Style="{StaticResource DividerStyle}" />
                                <Grid Style="{StaticResource RowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ModeLabel" Style="{StaticResource RowLabelStyle}" Text="Routing mode" />
                                    <ComboBox
                                        x:Name="ModeCombo"
                                        Grid.Column="1"
                                        MinWidth="144"
                                        VerticalAlignment="Center"
                                        AutomationProperties.LabeledBy="{Binding ElementName=ModeLabel}" />
                                </Grid>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource DividerStyle}" />
                                    <Grid Grid.Row="1" Style="{StaticResource RowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock x:Name="PingLabel" Text="Latency" />
                                            <TextBlock x:Name="PingResultText" MinHeight="20" Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <Button x:Name="PingButton" Grid.Column="1" VerticalAlignment="Center" Content="Test latency" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="ProfilesTitle"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Profiles"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AddProfileButton" Content="Add profile" />
                            <Button x:Name="ImportProfileButton" Content="Import" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Padding="4" Style="{StaticResource CardStyle}">
                        <Grid>
                            <ListView
                                x:Name="ProfileList"
                                AutomationProperties.LabeledBy="{Binding ElementName=ProfilesTitle}"
                                IsItemClickEnabled="True"
                                SelectionMode="Single">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="50" />
                                        <Setter Property="Padding" Value="10,6" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:ProfileItem">
                                        <Grid
                                            Background="Transparent"
                                            ColumnSpacing="10"
                                            DoubleTapped="ProfileRowDoubleTapped"
                                            RightTapped="ProfileRowRightTapped">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <SymbolIcon
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Symbol="Accept"
                                                Visibility="{x:Bind ActiveVisibility, Mode=OneWay}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Protocol, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Foreground="{x:Bind LatencyBrush, Mode=OneWay}"
                                                Text="{x:Bind Latency, Mode=OneWay}"
                                                Visibility="{x:Bind LatencyVisibility, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                x:Name="ProfilesEmptyText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="No profiles yet." />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="EditProfileButton" Content="Edit" IsEnabled="False" />
                            <Button x:Name="DeleteProfileButton" Content="Delete" IsEnabled="False" />
                            <Button x:Name="ProfilePingButton" Content="Test latency" Visibility="Collapsed" />
                            <Button x:Name="PingAllButton" Content="Test all" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="LogsPage" Grid.Row="1" RowSpacing="12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="LogsTitle" Style="{StaticResource TitleTextBlockStyle}" Text="Logs" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ClearLogsButton" Content="Clear logs" />
                        <Button x:Name="ToggleLogsButton" Content="Disable logging" />
                    </StackPanel>
                    <Border Grid.Row="2" Background="#171B21" CornerRadius="8">
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                x:Name="LogBox"
                                Margin="12,8"
                                AutomationProperties.LabeledBy="{Binding ElementName=LogsTitle}"
                                FontFamily="Consolas"
                                Foreground="#E6EDF3"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </Grid>

                <ScrollViewer x:Name="TunnelingPage" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel Spacing="16">
                        <TextBlock x:Name="TunnelingTitle" Style="{StaticResource TitleTextBlockStyle}" Text="Tunneling" />
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="RoutingLabel" Style="{StaticResource SubtitleTextBlockStyle}" Text="VLESS TUN routing" />
                            <Border Padding="14,10" Style="{StaticResource CardStyle}">
                                <Button x:Name="ExclusionSettingsButton" Content="Manage exclusions" />
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="FragmentationLabel" Style="{StaticResource SubtitleTextBlockStyle}" Text="TLS fragmentation" />
                            <Border Padding="14,10" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="FragmentationStatus" Style="{StaticResource SecondaryTextStyle}" />
                                    <Button x:Name="FragmentationSettingsButton" Content="Configure fragmentation" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel Padding="0,0,0,4" Spacing="16">
                        <TextBlock x:Name="SettingsTitle" Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

                        <StackPanel Spacing="8">
                            <TextBlock x:Name="AppearanceLabel" Style="{StaticResource SubtitleTextBlockStyle}" Text="Appearance" />
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource RowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ThemeLabel" Style="{StaticResource RowLabelStyle}" Text="Theme" />
                                        <ComboBox
                                            x:Name="ThemeCombo"
                                            Grid.Column="1"
                                            MinWidth="144"
                                            VerticalAlignment="Center"
                                            AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}">
                                            <ComboBoxItem x:Name="SystemThemeItem" Content="Use system setting" Tag="System" />
                                            <ComboBoxItem x:Name="LightThemeItem" Content="Light" Tag="Light" />
                                            <ComboBoxItem x:Name="DarkThemeItem" Content="Dark" Tag="Dark" />
                                        </ComboBox>
                                    </Grid>
                                    <Border Style="{StaticResource DividerStyle}" />
                                    <Grid Style="{StaticResource RowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LanguageLabel" Style="{StaticResource RowLabelStyle}" Text="Language" />
                                        <ComboBox
                                            x:Name="LanguageCombo"
                                            Grid.Column="1"
                                            MinWidth="144"
                                            VerticalAlignment="Center"
                                            AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}">
                                            <ComboBoxItem x:Name="EnglishLanguageItem" Content="English" Tag="English" />
                                            <ComboBoxItem x:Name="RussianLanguageItem" Content="Русский" Tag="Russian" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock x:Name="BehaviorLabel" Style="{StaticResource SubtitleTextBlockStyle}" Text="Application" />
                            <Border Padding="14,10" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="AppVersionLabel" />
                                    <Button x:Name="CheckUpdatesButton" Content="Check for updates" />
                                    <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" />
                                    <HyperlinkButton x:Name="DownloadUpdateLink" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid Style="{StaticResource RowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CloseBehaviorLabel" Style="{StaticResource RowLabelStyle}" Text="When closing the window" />
                                    <ComboBox
                                        x:Name="CloseBehaviorCombo"
                                        Grid.Column="1"
                                        MinWidth="144"
                                        MaxWidth="236"
                                        VerticalAlignment="Center"
                                        AutomationProperties.LabeledBy="{Binding ElementName=CloseBehaviorLabel}">
                                        <ComboBoxItem x:Name="AskCloseItem" Content="Ask every time" Tag="Ask" />
                                        <ComboBoxItem x:Name="TrayCloseItem" Content="Minimize to tray" Tag="MinimizeToTray" />
                                        <ComboBoxItem x:Name="ExitCloseItem" Content="Exit application" Tag="Exit" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock x:Name="ToolsLabel" Style="{StaticResource SubtitleTextBlockStyle}" Text="Tools" />
                            <Border Padding="14,10" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="8">
                                    <Button x:Name="CheckSshButton" Content="Check SSH" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="InstallDependenciesButton" Content="Install dependencies" />
                                        <Button x:Name="RemoveDependenciesButton" Content="Remove dependencies" />
                                    </StackPanel>
                                    <Button x:Name="RepairWintunButton" Content="Repair Wintun" />
                                    <Button x:Name="RestartAsAdminButton" Content="Restart as administrator" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
