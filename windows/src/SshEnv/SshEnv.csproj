<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SshEnv.Core\SshEnv.Core.csproj" />
  </ItemGroup>

  <Target Name="BuildAskPass" BeforeTargets="Build">
    <MSBuild Projects="..\SshEnv.AskPass\SshEnv.AskPass.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="CopyAskPass" AfterTargets="Build">
    <PropertyGroup>
      <AskPassExe>..\SshEnv.AskPass\bin\$(Configuration)\net10.0-windows\SshEnv.AskPass.exe</AskPassExe>
    </PropertyGroup>
    <Copy SourceFiles="$(AskPassExe)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('$(AskPassExe)')" />
  </Target>

  <Target Name="CopyAskPassPublish" AfterTargets="Publish">
    <PropertyGroup>
      <AskPassExe>..\SshEnv.AskPass\bin\$(Configuration)\net10.0-windows\SshEnv.AskPass.exe</AskPassExe>
    </PropertyGroup>
    <Copy SourceFiles="$(AskPassExe)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('$(AskPassExe)')" />
  </Target>

</Project>
